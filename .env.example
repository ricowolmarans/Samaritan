GROQ_API_KEY=paste-your-key-here
PORT=4817

# Check https://console.groq.com/docs/models if any of these stop working
STT_MODEL=whisper-large-v3-turbo
LLM_MODEL=openai/gpt-oss-20b
TTS_MODEL=canopylabs/orpheus-v1-english
TTS_VOICE=troy

# Home Assistant (optional). Remove the # from HA_URL and HA_TOKEN to turn it on.
# Token: Home Assistant > your profile > Security > Long-lived access tokens
# HA_URL=http://HA_IP:8123
# HA_TOKEN=paste-your-long-lived-token-here
# Voice unlocking is blocked unless you set this to true
# HA_ALLOW_UNLOCK=false
